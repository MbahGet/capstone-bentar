{
  "info": {
    "name": "Agent2 Analyze API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "description": "Cek status API dan memastikan model XGBoost sudah terlatih.",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Analyze Production CSV",
      "request": {
        "method": "POST",
        "description": "Upload CSV produksi harian dengan form-data key `file`. Gunakan `agent2/data/production_daily_dummy.csv` untuk test.",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/analyze",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analyze"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8002"
    }
  ]
}
