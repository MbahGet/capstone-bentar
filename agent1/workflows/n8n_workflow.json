    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet fullText = \"\";\n\nif (allItems.length > 1) {\n  fullText = allItems.map(item => Object.values(item.json).join(\", \")).join(\"\\n\");\n} else if (allItems.length === 1) {\n  fullText = allItems[0].json.text || allItems[0].json.textContent || allItems[0].json.data || \"\";\n}\n\nif (!fullText || fullText.trim().length === 0) {\n  return [{ json: { pageContent: \"KOSONG\", status: \"no_data\" } }];\n}\n\nconst chunks = [];\nconst CHUNK_SIZE = 1000;\n\nconst isCSV = (fullText.match(/,/g) || []).length > (fullText.length * 0.05);\nconst isLog = (fullText.match(/\\[(INFO|ERROR|WARN|DEBUG)\\]/i) || []).length > 0 || (fullText.match(/\\d{4}-\\d{2}-\\d{2}/g) || []).length > 5;\n\nif (isCSV || isLog) {\n  const lines = fullText.split(/\\r?\\n/);\n  let currentChunkLines = [];\n  let currentLength = 0;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i].trim();\n    if (!line) continue;\n\n    if (currentLength + line.length + 1 > CHUNK_SIZE && currentChunkLines.length > 0) {\n      const chunkText = currentChunkLines.join(\"\\n\");\n      chunks.push({\n        json: {\n          pageContent: chunkText,\n          metadata: { source: \"csv_line_chunker\", chunkLength: chunkText.length }\n        }\n      });\n      \n      currentChunkLines = currentChunkLines.slice(-2);\n      currentLength = currentChunkLines.join(\"\\n\").length;\n    }\n\n    currentChunkLines.push(line);\n    currentLength += line.length + 1;\n  }\n\n  if (currentChunkLines.length > 0) {\n    const finalChunkText = currentChunkLines.join(\"\\n\");\n    chunks.push({\n      json: {\n        pageContent: finalChunkText,\n        metadata: { source: \"csv_line_chunker\", chunkLength: finalChunkText.length }\n      }\n    });\n  }\n\n} else {\n  const words = fullText.split(/\\s+/);\n  let currentChunkWords = [];\n  let currentLength = 0;\n\n  for (let i = 0; i < words.length; i++) {\n    const word = words[i];\n    if (currentLength + word.length + 1 > CHUNK_SIZE && currentChunkWords.length > 0) {\n      const chunkText = currentChunkWords.join(\" \");\n      chunks.push({\n        json: {\n          pageContent: chunkText,\n          metadata: { source: \"fast_word_chunker\", chunkLength: chunkText.length }\n        }\n      });\n      currentChunkWords = currentChunkWords.slice(-5);\n      currentLength = currentChunkWords.join(\" \").length;\n    }\n    currentChunkWords.push(word);\n    currentLength += word.length + 1;\n  }\n\n  if (currentChunkWords.length > 0) {\n    const finalChunkText = currentChunkWords.join(\" \");\n    chunks.push({\n      json: {\n        pageContent: finalChunkText,\n        metadata: { source: \"fast_word_chunker\", chunkLength: finalChunkText.length }\n      }\n    });\n  }\n}\n\nreturn chunks;"
      },
