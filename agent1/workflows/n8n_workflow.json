    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet fullText = \"\";\n\nif (allItems.length > 1) {\n  fullText = allItems.map(item => {\n    return Object.values(item.json).join(\", \");\n  }).join(\"\\n\");\n} else {\n  fullText = allItems[0].json.text || allItems[0].json.data || \"\";\n}\n\nif (!fullText || fullText.trim().length === 0) {\n  return [{ json: { text: \"KOSONG\", status: \"no_data\" } }];\n}\n\nconst chunks = [];\nconst chunkSize = 1000;\n\nfor (let i = 0; i < fullText.length; i += chunkSize) {\n  chunks.push({\n    json: { \n      text: fullText.substring(i, i + chunkSize),\n      metadata: {\n        source: \"auto_chunker\",\n        size: fullText.length\n      }\n    }\n  });\n}\n\nreturn chunks;"
      },
